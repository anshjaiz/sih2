PORT=5001
# MongoDB Atlas connection string (Connect → Drivers in your Atlas console).
# Replace <db_user>, <db_password> and <cluster-name> with your values.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-name>.mongodb.net/cooperative_gig_platform?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────────────────
# Payments (Razorpay TEST mode)
# ──────────────────────────────────────────────────────────────────────
# Test keys from https://dashboard.razorpay.com/app/keys  (mode = Test).
# NEVER put live keys here, and NEVER expose the secret to the frontend.
# Leave both empty to run the built-in MOCK gateway (instant success demo).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Platform fee % override. When empty the fee is read from the admin
# Cooperative SETTINGS in the database (default 5%).
# PLATFORM_FEE_PERCENTAGE=5

# ──────────────────────────────────────────────────────────────────────
# AI Assistant (worker chatbot) — provider configuration
# ──────────────────────────────────────────────────────────────────────
# Primary provider + ordered fallbacks. The NEXT provider is ONLY used when
# the previous one fails (network error, rate limit, quota, timeout).
# Supported providers: gemini, groq, xai
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=groq,xai

# Provider API keys — set the ones you have. Providers without a key are
# skipped automatically. Get keys from:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
#   xAI:    https://console.x.ai
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# Optional per-provider model overrides (leave empty for defaults)
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-20b
XAI_MODEL=grok-2-latest
